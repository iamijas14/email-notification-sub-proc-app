{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Contact",
  "type": "object",
  "properties": {
    "AccountId": {
      "type": "string",
      "description": "The customer's AccountId."
    },
    "FirstName": {
      "type": "string",
      "description": "The customer's first name."
    },
    "Birthdate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The customer's Birthdate in YYYY-MM-DD format."
    },
    "Email": {
      "type": "string",
      "format": "email",
      "description": "The customer's email."
    },
    "MobilePhone": {
      "type": "string",
      "pattern": "^[0-9]{10,15}$",
      "description": "The customer's MobilePhone."
    },
    "Department": {
      "type": "string",
      "description": "The customer's Department name."
    }
  },
  "required": [
    "AccountId",
    "FirstName",
    "Birthdate",
    "Email",
    "MobilePhone",
    "Department"
  ],
  "additionalProperties": true
}