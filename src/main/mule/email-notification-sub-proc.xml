<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:amqp="http://www.mulesoft.org/schema/mule/amqp" xmlns:os="http://www.mulesoft.org/schema/mule/os"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
http://www.mulesoft.org/schema/mule/amqp http://www.mulesoft.org/schema/mule/amqp/current/mule-amqp.xsd">
	<flow name="abc-travels-email-notification-pub-flow" doc:id="e49101fa-5d86-4647-8e66-bdb6457d5eed" >
		<amqp:listener doc:name="Listener" doc:id="2ae634c2-a431-438d-820b-e7ee416f57da" config-ref="rabbitmq_Config" queueName="${rabbitmq.queueName}" ackMode="MANUAL">
		</amqp:listener>
		<ee:transform doc:name="correlationId, logParams, queueAckId, currentData" doc:id="d4b3c1d6-0bae-45fc-afcd-b7914e3670e2" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="logParams" ><![CDATA[%dw 2.0
output application/json
---
{
	"tracepoint": "Inbound Queue Entry",
	"source": flow.name
}]]></ee:set-variable>
				<ee:set-variable variableName="correlationId" ><![CDATA[%dw 2.0
output application/json
---
attributes.properties.correlationId default correlationId]]></ee:set-variable>
				<ee:set-variable variableName="queueAckId" ><![CDATA[%dw 2.0
output application/json
---
attributes.ackId]]></ee:set-variable>
				<ee:set-variable variableName="currentData" ><![CDATA[%dw 2.0
output application/java
---
payload]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="LOG: Entry" doc:id="47ac0ec8-b1c4-483e-b9e7-a895904e2698" name="info-logging-subflow" />
		<flow-ref doc:name="send-email-notification-process-subflow" doc:id="ec48146b-af49-485f-866b-d73273209803" name="send-email-notification-process-subflow"/>
		<ee:transform doc:name="logParams" doc:id="735e65e8-5160-4590-ae44-35b6ff1ab4d2" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="logParams" ><![CDATA[%dw 2.0
output application/json
---
{
	"tracepoint": "Inbound Queue Exit",
	"source": flow.name
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="LOG: Exit" doc:id="be50ac0c-ec4a-4af1-b550-4713dc61e7cd" name="info-logging-subflow" />
		<error-handler ref="global-error-handler" />
	</flow>
</mule>
